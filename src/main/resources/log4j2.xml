<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
	<Properties>
	<!-- Windows Server 
  <Property name="logDir">logs</Property>
  -->
  
  <!-- Use absolute path for reliability in Linux -->
  <Property name="logDir">/opt/tomcat/logs</Property>
 
	</Properties>
	<Appenders>
		<Console name="console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [uuid=%X{UUID},trace_id=%X{trace_id},span_id=%X{span_id}] %-5level %logger{36} (%F:%L) - %msg%n" />
		</Console>
		<RollingFile name="file"
			fileName="${logDir}/softwarerequest_api.log"
			filePattern="${logDir}/softwarerequest_api-%d{yyyy-MM-dd}-%i.log">
			<!-- <JsonLayout complete="false" compact="true" eventEol="true" properties="true" /> -->
   			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] [uuid=%X{UUID},trace_id=%X{trace_id},span_id=%X{span_id}] %-5level %logger{36} (%F:%L) - %msg%n" />
			<Policies>
				<TimeBasedTriggeringPolicy interval="1" modulate="true"/>
				<SizeBasedTriggeringPolicy size="100MB" />
			</Policies>
			<DefaultRolloverStrategy max="20" />
		</RollingFile>
	</Appenders>
	<Loggers>
		<Logger name="com.netflix.discovery" level="error" additivity="false">
			<!-- Heartbeat/registry-fetch retries log at ERROR on every attempt while
			     the Eureka server is unreachable; BurstFilter throttles the repeats
			     to roughly one line per 5 minutes instead of one every ~30s. -->
			<BurstFilter level="ERROR" rate="0.0033" maxBurst="1" onMatch="ACCEPT" onMismatch="DENY" />
			<AppenderRef ref="console" />
			<AppenderRef ref="file" />
		</Logger>
		<Logger name="com.br" level="debug" additivity="false">
			<AppenderRef ref="console" />
			<AppenderRef ref="file" />
		</Logger>
		<Root level="info">
			<AppenderRef ref="console" />
			<AppenderRef ref="file" />
		</Root>
	</Loggers>
</Configuration>